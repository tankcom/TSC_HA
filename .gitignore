# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Tool caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local secrets (TSC host, API keys, HA tokens) go here, never in git
.env
.env.*
!.env.example

# Local Home Assistant instance used for testing the integration
config/
home-assistant.log*
home-assistant.db*
backup/
