  "config": {
    "step": {
      "user": {
        "title": "Connect to TeslaSolarCharger",
        "description": "Enter the address of the machine that runs TeslaSolarCharger. Its API listens on port 7190 and does not need an API key.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "use_ssl": "Connect over HTTPS",
          "verify_ssl": "Validate the server certificate",
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "update_interval_seconds": "Update interval"
        },
        "data_description": {
          "host": "IP address or host name of the server running TeslaSolarCharger.",
          "port": "Port of the TeslaSolarCharger API, 7190 unless you changed it.",
          "use_ssl": "Enable this when TLS is terminated in front of TeslaSolarCharger.",
          "verify_ssl": "Turn this off for a self-signed certificate.",
          "api_key": "Leave empty unless something in front of TeslaSolarCharger checks a key. It is sent as the x-api-key header.",
          "update_interval_seconds": "How often the values are read from the API, in seconds."
        }
      },
      "reconfigure": {
        "title": "Reconfigure TeslaSolarCharger",
        "description": "Change where this TeslaSolarCharger installation is reachable.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "use_ssl": "[%key:component::tesla_solar_charger::config::step::user::data::use_ssl%]",
          "verify_ssl": "[%key:component::tesla_solar_charger::config::step::user::data::verify_ssl%]",
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "host": "[%key:component::tesla_solar_charger::config::step::user::data_description::host%]",
          "port": "[%key:component::tesla_solar_charger::config::step::user::data_description::port%]",
          "use_ssl": "[%key:component::tesla_solar_charger::config::step::user::data_description::use_ssl%]",
          "verify_ssl": "[%key:component::tesla_solar_charger::config::step::user::data_description::verify_ssl%]",
          "api_key": "[%key:component::tesla_solar_charger::config::step::user::data_description::api_key%]"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach {url}. Check the host, the port and whether TeslaSolarCharger is running.",
      "not_tesla_solar_charger": "{url} answered, but not as a TeslaSolarCharger API."
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "TeslaSolarCharger options",
        "data": {
          "update_interval_seconds": "[%key:component::tesla_solar_charger::config::step::user::data::update_interval_seconds%]",
          "use_ssl": "[%key:component::tesla_solar_charger::config::step::user::data::use_ssl%]",
          "verify_ssl": "[%key:component::tesla_solar_charger::config::step::user::data::verify_ssl%]",
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "update_interval_seconds": "[%key:component::tesla_solar_charger::config::step::user::data_description::update_interval_seconds%]",
          "use_ssl": "[%key:component::tesla_solar_charger::config::step::user::data_description::use_ssl%]",
          "verify_ssl": "[%key:component::tesla_solar_charger::config::step::user::data_description::verify_ssl%]",
          "api_key": "[%key:component::tesla_solar_charger::config::step::user::data_description::api_key%]"
        }
      }
    }
  },
  "exceptions": {
    "config_entry_not_found": {
      "message": "Home Assistant has no TeslaSolarCharger entry with the id {config_entry_id}."
    },
    "entry_not_loaded": {
      "message": "The TeslaSolarCharger entry {title} is not set up, so its settings cannot be changed."
    },
    "unknown_setting": {
      "message": "{field} is not a setting of the TeslaSolarCharger base configuration. Available settings: {known}."
    },
    "invalid_value": {
      "message": "{field} expects {expected}."
    },
    "text_too_long": {
      "message": "{field} accepts at most {max} characters."
    }
  },
  "services": {
    "set_base_configuration_value": {
      "name": "Set a TeslaSolarCharger setting",
      "description": "Changes one property of the TeslaSolarCharger base configuration. Both spellings of a property name are accepted (PowerBuffer or power_buffer), and the value is converted to the type TeslaSolarCharger expects. Pass null to clear a property that TeslaSolarCharger allows to be empty.",
      "fields": {
        "config_entry_id": {
          "name": "Installation",
          "description": "The TeslaSolarCharger entry to change."
        },
        "field": {
          "name": "Setting",
          "description": "Property to change, for example PowerBuffer or minutes_until_switch_on."
        },
        "value": {
          "name": "Value",
          "description": "New value. Use null to clear an optional property."
        }
      }
    }
  }
